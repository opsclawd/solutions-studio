{
  "name": "@solutions-studio/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "tracer": "tsx scripts/run-tracer.ts",
    "harness": "tsx scripts/run-phase-1-exit-gate.ts",
    "exit-gate": "tsx scripts/run-phase-1-exit-gate.ts && tsx scripts/run-phase-2-exit-gate.ts",
    "exit-gate:phase1": "tsx scripts/run-phase-1-exit-gate.ts",
    "exit-gate:phase2": "tsx scripts/run-phase-2-exit-gate.ts",
    "eval": "tsx scripts/run-evaluation.ts",
    "project": "tsx scripts/run-project-baseline.ts",
    "serve": "tsx scripts/run-http-server.ts"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.4",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.4.2",
    "@solutions-studio/contracts": "workspace:*",
    "@solutions-studio/domain": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
