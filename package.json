{
  "name": "solutions-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm --filter @solutions-studio/orchestrator test && pnpm --filter @solutions-studio/web test",
    "test:browser": "pnpm --filter @solutions-studio/web test:browser",
    "test:integration": "pnpm --filter @solutions-studio/orchestrator test:integration",
    "dev:web": "pnpm --filter @solutions-studio/web dev",
    "tracer": "pnpm --filter @solutions-studio/orchestrator tracer",
    "project": "pnpm --filter @solutions-studio/orchestrator project",
    "lint": "eslint .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "postinstall": "node scripts/check-hooks.js || true"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write",
    "**/*.{js,jsx,mjs,cjs}": "prettier --write",
    "**/*.{json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.17.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.1"
  }
}
