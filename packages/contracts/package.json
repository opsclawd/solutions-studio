{
  "name": "@solutions-studio/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./requirements": {
      "types": "./src/requirements/index.ts",
      "import": "./dist/src/requirements/index.js",
      "default": "./dist/src/requirements/index.js"
    },
    "./evaluation": {
      "types": "./src/evaluation/index.ts",
      "import": "./dist/src/evaluation/index.js",
      "default": "./dist/src/evaluation/index.js"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./dist/src/http/index.js",
      "default": "./dist/src/http/index.js"
    },
    "./identity": {
      "types": "./src/identity/index.ts",
      "import": "./dist/src/identity/index.js",
      "default": "./dist/src/identity/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit"
  },
  "dependencies": {
    "@solutions-studio/domain": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
