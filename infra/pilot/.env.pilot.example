# Solutions Studio Pilot Environment Configuration

# Ports
WEB_PORT=3000
ORCHESTRATOR_PORT=4000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080

# PostgreSQL Configuration
POSTGRES_USER=solutions_user
POSTGRES_PASSWORD=solutions_pass
POSTGRES_DB=solutions_studio

# Keycloak Administrator Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Orchestrator Configuration
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GENERATION_PROVIDER=fake
ALLOW_REAL_BACKLOG_MUTATION=false

# Web Configuration
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/solutions-studio
NEXT_PUBLIC_OIDC_CLIENT_ID=solutions-studio-web
